# ─────────────────────────────────────────────
# .env.example — このファイルを .env にコピーして使う
# .env は .gitignore 済み。キーやパスワードを GitHub にコミットしない
# ─────────────────────────────────────────────

# ── DB切り替え ─────────────────────────────
USE_MYSQL=false              # false: SQLite（ローカル）／ true: Azure Database for MySQL

# ── SQLite（USE_MYSQL=false のとき）────────
SQLITE_PATH=giftia.db        # 配布された giftia.db を backend/ に置く

# ── MySQL（USE_MYSQL=true のとき）───────────
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_USER=giftiaadmin
DB_PASSWORD=（ここには書かない。ローカルは各自の .env、本番は Azure のアプリ設定に置く）
DB_NAME=giftia
DB_SSL=true                  # Azure は true。ローカルの MySQL で試すときだけ false

# ── CORS（next dev から直接呼ぶとき）────────
CORS_ORIGINS=http://localhost:3000

# ── LLM（任意・4周目）──────────────────────
# 講師から配布されたチーム用のキー。両方そろったときだけ LLM を使う
OPENAI_API_KEY=
OPENAI_MODEL=
